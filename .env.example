# FastMCP Server Configuration
MCP_HOST=0.0.0.0
MCP_PORT=8001

# MySQL Database Configuration
# You can set either individual credentials or a combined DATABASE_URL
DATABASE_URL=mysql+pymysql://your_mysql_username:your_mysql_password@localhost:3306/your_database_name

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_database_name
MYSQL_POOL_SIZE=5

# SSL Configuration (for cloud databases like AWS RDS, PlanetScale, Aiven)
# DB_SSL_MODE=enable
# DB_SSL_CA_PATH=ca.pem
# DB_SSL_CA_CONTENT=

# Client Testing Configuration
MCP_SERVER_URL=http://localhost:8001/mcp
